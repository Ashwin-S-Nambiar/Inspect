---
import Entry from '../../layouts/Entry.astro';
import { inSection, type Post, slugOf } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await inSection('projects');
  return posts.map((post, i) => ({
    params: { slug: slugOf(post) },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
---

<Entry post={post} newer={newer} older={older} />
