---
import { render } from 'astro:content';
import CodeCard from '../components/CodeCard.astro';
import Hero from '../components/Hero.astro';
import ProjectLink from '../components/ProjectLink.astro';
import Related from '../components/Related.astro';
import cards from '../lib/og-cards.json';
import Rows from '../components/Rows.astro';
import { formatDate, href, kindLabel, notesFor, type Post, readTime, sectionOf, vt, writeUpFor } from '../lib/posts';
import Base from './Base.astro';
import '../styles/post.css';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const articleCards: Record<string, string> = cards;
const { Content, headings } = await render(post);
const sections = headings.filter((h) => h.depth === 2);
const { title, dek, date, updated, kind, project, hero } = post.data;
const name = vt(post);
const minutes = readTime(post);
const section = sectionOf(post);
const writeUp = section === 'notes' ? await writeUpFor(project?.name) : undefined;
const notes = section === 'projects' ? await notesFor(post) : [];
const home = section === 'projects' ? { href: '/', label: 'All projects' } : { href: '/notes/', label: 'All notes' };
Astro.locals.project = project;
Astro.locals.writeUp = writeUp && href(writeUp);
const links = project && [
  project.live && { href: project.live, label: 'Live' },
  project.repo && { href: project.repo, label: 'Source' },
].filter((l): l is { href: string; label: string } => Boolean(l));
---

<Base title={title} description={dek} type="article" image={post.data.og?.src ?? articleCards[post.id]} imageAlt={title}>
  {sections.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <p>On this page</p>
      <ol>
        <li><a href="#top" data-toc="top">{title}</a></li>
        {sections.map((h) => (
          <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  )}
  {sections.length > 0 && (
    <script is:inline>
      addEventListener(
        'pagereveal',
        () => {
          const links = [...document.querySelectorAll('[data-toc]')];
          let current = 'top';
          const heads = links.slice(1).map((a) => document.getElementById(a.dataset.toc)).filter(Boolean);
          for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.35) current = h.id;
          if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) {
            for (const h of heads) if (h.getBoundingClientRect().top < innerHeight) current = h.id;
          }
          const nav = document.querySelector('.toc');
          nav?.classList.add('still');
          for (const a of links) if (a.dataset.toc === current) a.setAttribute('aria-current', 'true');
          requestAnimationFrame(() => requestAnimationFrame(() => nav?.classList.remove('still')));
        },
        { once: true },
      );
    </script>
  )}
  <a class="back" href={home.href} data-home={home.href} data-in style="--i:1">
    <svg class="ic" aria-hidden="true"><use href="#i-back"></use></svg>
    {home.label}
  </a>
  <article>
    <header>
      <h1 class="post-title" id="top" style={`view-transition-name: title-${name}`}>{title}</h1>
      <p class="byline" data-in style="--i:2">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>Revised {formatDate(updated)}</span>}
        {kind !== 'project' && <span>{kindLabel(kind)}</span>}
        <span>{minutes} min read</span>
      </p>
      <p class="dek" data-in style="--i:3">{dek}</p>
      {hero && <Hero post={post} hero={hero} />}
      {project && (
        <dl class:list={['facts', { two: !links?.length }]} data-in style="--i:5">
          {section === 'projects' ? (
            project.made && <div><dt>Made</dt><dd>{project.made}</dd></div>
          ) : (
            <div><dt>Project</dt><dd>{writeUp ? <a href={href(writeUp)}>{project.name}</a> : project.name}</dd></div>
          )}
          {project.stack.length > 0 && <div><dt>Stack</dt><dd>{project.stack.join(', ')}</dd></div>}
          {links && links.length > 0 && (
            <div>
              <dt>Links</dt>
              <dd class="links">
                {links.map((l, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true">·</span>}
                    <a href={l.href} rel="noopener">{l.label}</a>
                  </>
                ))}
              </dd>
            </div>
          )}
        </dl>
      )}
    </header>
    <div class="prose" data-in style="--i:6">
      <Content components={{ pre: CodeCard, Project: ProjectLink }} />
    </div>
    {notes.length > 0 && (
      <section class="more" aria-labelledby="notes-h">
        <h2 class="sect" id="notes-h">Notes on {project?.name ?? title} <span>{notes.length}</span></h2>
        <Rows posts={notes} />
      </section>
    )}
    {post.data.related.length > 0 && <Related items={post.data.related} />}
    {(newer || older) && (
      <nav class="pager" aria-label={section === 'projects' ? 'More projects' : 'More notes'}>
        {newer && (
          <a class="prev" href={href(newer)}>
            <span>Newer</span>
            <b>{newer.data.title}</b>
          </a>
        )}
        {older && (
          <a class="next" href={href(older)}>
            <span>Older</span>
            <b>{older.data.title}</b>
          </a>
        )}
      </nav>
    )}
  </article>
  <script>
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
    const heads = links
      .map((a) => document.getElementById(a.dataset.toc ?? ''))
      .filter((h): h is HTMLElement => Boolean(h));
    let queued = false;
    let aimed: string | undefined;
    const update = () => {
      queued = false;
      let current = 'top';
      for (const h of heads.slice(1)) if (h.getBoundingClientRect().top < innerHeight * 0.35) current = h.id;
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) {
        for (const h of heads.slice(1)) if (h.getBoundingClientRect().top < innerHeight) current = h.id;
      }
      if (aimed) current = aimed;
      for (const a of links) {
        if (a.dataset.toc === current) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
    const release = () => {
      if (!aimed) return;
      aimed = undefined;
      queue();
    };
    addEventListener('scrollend', release);
    addEventListener('wheel', release, { passive: true });
    addEventListener('touchstart', release, { passive: true });
    for (const a of links) {
      a.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const id = a.dataset.toc ?? 'top';
        const target = id === 'top' ? undefined : document.getElementById(id);
        if (id !== 'top' && !target) return;
        e.preventDefault();
        const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
        const top = target ? target.getBoundingClientRect().top + scrollY - Number.parseFloat(getComputedStyle(target).scrollMarginTop || '0') : 0;
        const max = document.documentElement.scrollHeight - innerHeight;
        history.replaceState(history.state, '', target ? `#${id}` : location.pathname);
        aimed = id;
        update();
        if (Math.abs(Math.min(top, max) - scrollY) < 2) {
          aimed = undefined;
          return;
        }
        scrollTo({ top, behavior });
      });
    }

    const back = document.querySelector<HTMLAnchorElement>('.back');
    const nav = (window as { navigation?: Navigation }).navigation;
    const origin = () => {
      const current = nav?.currentEntry;
      if (!current) return;
      const entries = nav.entries();
      for (let i = current.index - 1; i >= 0; i--) {
        const url = entries[i].url ? new URL(entries[i].url as string) : undefined;
        if (!url || url.origin !== location.origin) return;
        if (url.pathname === location.pathname) continue;
        return url.pathname === '/' || url.pathname === '/notes/' || url.pathname.startsWith('/tags/') ? { entry: entries[i], path: url.pathname } : undefined;
      }
    };
    if (back && nav) {
      const sync = () => {
        back.href = origin()?.path ?? back.dataset.home ?? '/';
      };
      sync();
      addEventListener('pageshow', sync);
      addEventListener('hashchange', sync);
      back.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const found = origin();
        if (!found) return;
        e.preventDefault();
        const traversal = nav.traverseTo(found.entry.key);
        traversal.committed?.catch(() => {});
        traversal.finished?.catch((err) => {
          if (err?.name !== 'AbortError') location.href = found.path;
        });
      });
    }

    for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy')) {
      let timer: ReturnType<typeof setTimeout> | undefined;
      btn.addEventListener('click', async () => {
        const code = btn.closest('.codecard')?.querySelector('pre')?.innerText ?? '';
        try {
          await navigator.clipboard.writeText(code);
        } catch {
          return;
        }
        btn.toggleAttribute('data-done', true);
        btn.dataset.tip = 'Copied';
        clearTimeout(timer);
        timer = setTimeout(() => {
          btn.removeAttribute('data-done');
          btn.dataset.tip = 'Copy';
        }, 1400);
      });
    }
  </script>
</Base>
