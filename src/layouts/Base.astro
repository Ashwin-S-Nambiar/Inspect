---
import { Font } from 'astro:assets';
import FontPreloads from '../components/FontPreloads.astro';
import Sprite from '../components/Sprite.astro';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og.jpg?v=3',
  imageAlt = `${site.name}: ${site.tagline.toLowerCase()}`,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(`${Astro.url.pathname.replace(/\/$/, '')}/`, Astro.site);
const ogImage = new URL(image, Astro.site);
const projectCard = ogImage.pathname === '/og.jpg' || ogImage.pathname.startsWith('/og/');
const home = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {projectCard && <meta property="og:image:type" content="image/jpeg" />}
    {projectCard && <meta property="og:image:width" content="1200" />}
    {projectCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <FontPreloads />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-mono" />
    <style is:inline>html{color-scheme:light dark}html,body{background:#fbfbfa}@media (prefers-color-scheme:dark){html,body{background:#111110}}</style>
    <link rel="expect" href="#end" blocking="render" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        const show = () => d.classList.add('ready');
        try {
          if (sessionStorage.getItem('inspect:in')) d.classList.add('instant', 'ready');
          else sessionStorage.setItem('inspect:in', '1');
        } catch {}
        const managed = 'onpagereveal' in window && 'navigation' in window;
        if (managed) history.scrollRestoration = 'manual';
        const list = () => location.pathname === '/' || location.pathname === '/notes/' || location.pathname.startsWith('/tags/');
        const listKey = () => `inspect:scroll:${location.pathname}${location.search}`;
        const save = () => {
          try {
            history.replaceState({ ...history.state, y: scrollY }, '');
            if (list()) sessionStorage.setItem(listKey(), String(scrollY));
          } catch {}
        };
        const clearNames = () => {
          d.classList.remove('vt-post');
          for (const t of document.querySelectorAll('.vt-keep, .vt-solo')) t.classList.remove('vt-keep', 'vt-solo');
        };
        const unname = (other) => {
          const path = other ? new URL(other).pathname : '';
          const post = /^\/(projects|notes)\/[^/]+\/$/.test(path);
          d.classList.toggle('vt-post', post);
          for (const t of document.querySelectorAll('.row-t')) {
            t.classList.toggle('vt-keep', post && new URL(t.closest('a').href).pathname === path);
          }
          for (const t of document.querySelectorAll('.vt-solo')) t.classList.remove('vt-solo');
        };
        const seen = (el) => {
          const r = el.getBoundingClientRect();
          return r.top >= 0 && r.bottom <= innerHeight;
        };
        const heroes = () => document.querySelectorAll('.row-t.vt-keep, .post-title');
        let destination;
        if (managed) navigation.addEventListener('navigate', (e) => {
          if (!e.destination.sameDocument) destination = e.destination.url;
        });
        let finishReturn = () => {};
        const returnTitle = (row, from) => {
          let source;
          try {
            source = JSON.parse(sessionStorage.getItem('inspect:return-title') || 'null');
            sessionStorage.removeItem('inspect:return-title');
          } catch {}
          if (!row || !source || source.from !== from || source.to !== location.href ||
              source.name !== row.style.viewTransitionName || !seen(row) ||
              matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const to = row.getBoundingClientRect();
          const ghost = row.cloneNode(true);
          ghost.className = 'return-title';
          const css = getComputedStyle(row);
          for (const property of ['fontFamily', 'fontSize', 'fontWeight', 'fontStyle', 'lineHeight', 'letterSpacing', 'color', 'fontFeatureSettings', 'textWrap']) {
            ghost.style[property] = css[property];
          }
          Object.assign(ghost.style, {
            left: `${to.left}px`, top: `${to.top}px`, width: `${to.width}px`, height: `${to.height}px`,
            viewTransitionName: 'none',
          });
          ghost.setAttribute('aria-hidden', 'true');
          document.body.append(ghost);
          row.classList.add('returning-title');
          const animation = ghost.animate([
            { transform: `translate(${source.rect.left - to.left}px, ${source.rect.top - to.top}px) scale(${source.rect.width / to.width}, ${source.rect.height / to.height})` },
            { transform: 'none' },
          ], { duration: 280, easing: css.getPropertyValue('--drawer').trim(), fill: 'both' });
          const y = scrollY;
          const scrolled = () => { if (scrollY !== y) finish(); };
          let done = false;
          const finish = () => {
            if (done) return;
            done = true;
            ghost.remove();
            row.classList.remove('returning-title');
            removeEventListener('scroll', scrolled);
            finishReturn = () => {};
            animation.cancel();
          };
          finishReturn = finish;
          addEventListener('scroll', scrolled, { passive: true });
          animation.finished.then(finish, finish);
        };
        addEventListener('pageswap', (e) => {
          finishReturn();
          save();
          try {
            sessionStorage.removeItem('inspect:return-title');
            const title = document.querySelector('.post-title');
            const to = e.activation?.entry?.url ?? destination;
            if (to) sessionStorage.setItem('inspect:navigation', JSON.stringify({ from: location.href, to }));
            if (title && seen(title) && to && /^\/(?:notes\/|tags\/[^/]+\/)?$/.test(new URL(to).pathname)) {
              sessionStorage.setItem('inspect:return-title', JSON.stringify({
                from: location.href, to, name: title.style.viewTransitionName,
                rect: title.getBoundingClientRect().toJSON(),
              }));
            }
          } catch {}
          if (!e.viewTransition) return;
          unname(e.activation?.entry?.url);
          for (const t of heroes()) if (!seen(t)) t.classList.add('vt-solo');
          // Temporary names must not survive in the back/forward cache.
          e.viewTransition.finished.then(clearNames, clearNames);
        });
        addEventListener('pagehide', () => { finishReturn(); save(); });
        let restored = false;
        addEventListener('pageshow', (e) => { restored = e.persisted; });
        addEventListener('pagereveal', (e) => {
          // Cached documents can paint once before the native crossfade starts.
          // Keep the restored page steady and move only a copy of its title.
          const cached = restored;
          restored = false;
          if (cached && e.viewTransition) {
            e.viewTransition.ready.catch(() => {});
            e.viewTransition.skipTransition();
          }
          if (e.viewTransition) d.classList.add('ready', 'instant');
          if (!managed) return;
          const act = navigation.activation;
          let previous = act?.from?.url;
          if (!previous) {
            try {
              const swap = JSON.parse(sessionStorage.getItem('inspect:navigation') || 'null');
              if (swap?.to === location.href) previous = swap.from;
            } catch {}
          }
          const fromPost = previous && /^\/(projects|notes)\/[^/]+\/$/.test(new URL(previous).pathname);
          clearNames();
          if (e.viewTransition) unname(previous);
          const timing = performance.getEntriesByType('navigation')[0]?.type;
          const type = act?.navigationType ?? (timing === 'back_forward' ? 'traverse' : timing === 'reload' ? 'reload' : 'push');
          if (e.viewTransition && e.viewTransition.types) {
            const back = type === 'traverse' && act?.entry && act?.from && act.entry.index < act.from.index;
            e.viewTransition.types.add(back ? 'back' : 'forward');
          }
          let y = (type === 'traverse' || type === 'reload') ? history.state?.y : undefined;
          // Home links also return to the last list position, without adding a
          // visible scroll after the incoming snapshot has already been taken.
          if (typeof y !== 'number' && list() && fromPost) {
            try {
              const saved = sessionStorage.getItem(listKey());
              if (saved !== null) y = Number(saved);
            } catch {}
          }
          const savedPosition = typeof y === 'number' && Number.isFinite(y);
          if (savedPosition) scrollTo({ top: y, left: 0, behavior: 'instant' });
          else if (!location.hash) scrollTo({ top: 0, left: 0, behavior: 'instant' });
          if (!e.viewTransition) return;
          const row = document.querySelector('.row-t.vt-keep');
          if (row && !savedPosition && !seen(row)) {
            const r = row.getBoundingClientRect();
            scrollTo(0, Math.max(0, scrollY + r.top - (innerHeight - r.height) / 2));
          }
          for (const t of heroes()) if (!seen(t)) t.classList.add('vt-solo');
          if (cached) {
            returnTitle(row, previous);
            clearNames();
            return;
          }
          e.viewTransition.ready.then(pace, () => {});
          e.viewTransition.finished.then(clearNames, clearNames);
        });
        const pace = () => {
          const title = d
            .getAnimations({ subtree: true })
            .filter((a) => a.effect?.pseudoElement?.includes('(title-'));
          const group = title.find((a) => a.effect.pseudoElement.startsWith('::view-transition-group'));
          if (!group) return;
          const [from, to] = [group.effect.getKeyframes()[0], group.effect.getKeyframes().at(-1)].map(
            (k) => new DOMMatrix(k.transform),
          );
          const far = Math.hypot(to.e - from.e, to.f - from.f);
          const duration = Math.min(280, Math.max(240, 220 + far * 0.15));
          for (const a of title) a.effect.updateTiming({ duration });
        };
        const css = getComputedStyle(d);
        const first = (v) => css.getPropertyValue(v).split(',')[0].trim();
        const fonts = document.fonts
          ? Promise.all([
              ...['--font-sans', '--font-mono'].map((v) => document.fonts.load(`1em ${first(v)}`)),
              document.fonts.load(`italic 1em ${first('--font-serif')}`),
            ]).then(() => document.fonts.ready)
          : Promise.resolve();
        Promise.race([fonts, new Promise((r) => setTimeout(r, 600))]).then(show, show);
      })();
    </script>
  </head>
  <body>
    <Sprite />
    <div class="page">
      <header class="top">
        <a class="brand" href="/" aria-current={home ? 'page' : undefined}>
          <svg class="brand-mark" aria-hidden="true"><use href="#mark"></use></svg>
          <span class="brand-name">{site.name}</span>
        </a>
        <a class="rss" href="/rss.xml">
          <svg class="ic" aria-hidden="true"><use href="#i-rss"></use></svg>
          RSS
        </a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="credit">
        <span>Made by <a href={site.author} rel="noopener">Ashwin</a></span>
        <a href={site.source} rel="noopener">Source</a>
      </footer>
    </div>
    <script is:inline>
      (() => {
        let seen = [];
        try {
          seen = JSON.parse(sessionStorage.getItem('inspect:seen') || '[]');
        } catch {}
        const known = new Set(seen);
        const remember = (src) => {
          if (!src || known.has(src)) return;
          known.add(src);
          try {
            sessionStorage.setItem('inspect:seen', JSON.stringify([...known].slice(-400)));
          } catch {}
        };
        const hold = (el, img) => {
          const src = img.getAttribute('src');
          if (img.complete && img.naturalWidth) {
            remember(src);
            return;
          }
          el.classList.add('fade', 'wait');
          if (known.has(src)) el.classList.add('quick');
          img.addEventListener(
            'load',
            () => {
              remember(src);
              el.classList.remove('wait');
            },
            { once: true },
          );
          img.addEventListener('error', () => el.classList.remove('wait'), { once: true });
        };
        for (const img of document.querySelectorAll('main img')) hold(img, img);
        for (const v of document.querySelectorAll('main video[poster]')) {
          const img = new Image();
          img.src = v.getAttribute('poster');
          hold(v, img);
        }
      })();
    </script>
    <span id="end" hidden></span>
    <script>
      import { initTips } from '../lib/tip';
      initTips();

      const tab = ['/', '/notes/'].includes(location.pathname) ? location.pathname : null;
      try {
        if (tab) localStorage.setItem('inspect:tab', tab);
        const last = localStorage.getItem('inspect:tab');
        const brand = document.querySelector<HTMLAnchorElement>('.brand');
        if (!tab && brand && last === '/notes/') brand.href = last;
      } catch {}
    </script>
  </body>
</html>
