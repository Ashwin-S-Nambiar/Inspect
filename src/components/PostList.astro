---
import { allPosts, type Post, type Section, sectionOf, tagLabel } from '../lib/posts';
import { site } from '../site';
import Rows from './Rows.astro';

interface Props {
  posts: Post[];
  section?: Section;
  tag?: string;
}

const { posts, section = 'projects', tag } = Astro.props;
const everything = await allPosts();
const lists = {
  projects: everything.filter((p) => sectionOf(p) === 'projects'),
  notes: everything.filter((p) => sectionOf(p) === 'notes'),
};
const filters = site.filters.filter((f) => lists.notes.some((p) => p.data.tags.includes(f)));
const tagFilters = tag ? filters : [];
const titles = { projects: `${site.name} · ${site.tagline}`, notes: `Notes · ${site.name}` };
const headings = { projects: 'Projects', notes: 'Notes' };
---

{tag ? (
  <>
    <h2 class="sect" data-in style="--i:3">{tagLabel(tag)} <span>{posts.length}</span></h2>
    {tagFilters.length > 0 && (
      <nav class="filters" aria-label="Filter notes by tag" data-in style="--i:4">
        <a class="chip" href="/notes/">All</a>
        {tagFilters.map((f) => (
          <a class="chip" href={`/notes/?tag=${f}`} aria-current={f === tag ? 'page' : undefined}>{tagLabel(f)}</a>
        ))}
        {!tagFilters.includes(tag) && <a class="chip" href={`/tags/${tag}/`} aria-current="page">{tagLabel(tag)}</a>}
      </nav>
    )}
    <Rows posts={posts} eagerCount={2} />
  </>
) : (
  <>
    <div class="switch-row" data-in style="--i:3">
      <nav class="sections" aria-label="Sections" data-sections style={`--at:${section === 'notes' ? 1 : 0}`}>
        <span class="pill" aria-hidden="true"></span>
        {(['projects', 'notes'] as const).map((s) => (
          <a
            href={s === 'projects' ? '/' : '/notes/'}
            data-tab={s}
            data-title={titles[s]}
            aria-current={s === section ? 'page' : undefined}
          >
            <span class="sec-l">{headings[s]}</span>
            <span class="sec-n">{lists[s].length}</span>
          </a>
        ))}
      </nav>
      {filters.length > 0 && (
        <nav class="filters" aria-label="Filter notes by tag" data-filters inert={section !== 'notes'}>
          <a class="chip" href="/notes/" data-filter="" aria-current="page">All</a>
          {filters.map((f) => (
            <a class="chip" href={`/notes/?tag=${f}`} data-filter={f}>{tagLabel(f)}</a>
          ))}
        </nav>
      )}
    </div>
    <h2 class="sr" data-heading>{headings[section]}</h2>
    <div class="panels" data-panels>
      {(['projects', 'notes'] as const).map((s) => (
        <div class="panel" data-panel={s} inert={s !== section}>
          <Rows posts={lists[s]} eagerCount={s === section ? 2 : 0} />
        </div>
      ))}
    </div>
    <script is:inline>
      (() => {
        const nav = document.querySelector('[data-sections]');
        const box = document.querySelector('[data-panels]');
        if (!nav || !box) return;
        const SPRING =
          'linear(0, 0.027, 0.096, 0.188, 0.293, 0.4, 0.503, 0.598, 0.684, 0.758, 0.82, 0.872, 0.913, 0.946, 0.971, 0.989, 1.002, 1.011, 1.016, 1.019, 1.02, 1.02, 1.018, 1.016, 1.014, 1.012, 1.01, 1.008, 1.007, 1.005, 1)';
        const OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
        const tabs = [...nav.querySelectorAll('a[data-tab]')];
        const panels = [...box.querySelectorAll('[data-panel]')];
        const notes = box.querySelector('[data-panel="notes"]');
        const chipBar = document.querySelector('[data-filters]');
        const chips = chipBar ? [...chipBar.querySelectorAll('[data-filter]')] : [];
        const reduced = matchMedia('(prefers-reduced-motion: reduce)');
        const heading = document.querySelector('[data-heading]');
        const notesTab = tabs.find((a) => a.dataset.tab === 'notes');
        const known = chips.map((c) => c.dataset.filter);
        const running = new Set();
        let turn = 0;
        const play = (el, frames, opts) => {
          const a = el.animate(frames, { fill: 'backwards', ...opts });
          running.add(a);
          const done = () => running.delete(a);
          a.finished.then(done, done);
          return a;
        };
        const stop = () => {
          turn++;
          for (const a of running) a.cancel();
          running.clear();
          for (const el of [...panels, chipBar]) el?.classList.remove('leaving');
        };
        const seen = (el) => {
          const r = el.getBoundingClientRect();
          return r.height > 0 && r.bottom > 0 && r.top < innerHeight;
        };
        const rowsOf = (panel) => [...panel.querySelectorAll('.row')].filter((r) => !r.hidden);
        const enter = (els, { dx = 0, dy = 0, delay = 0, step = 28 }) => {
          let i = 0;
          for (const el of els) {
            if (!seen(el)) continue;
            const at = delay + Math.min(i++, 7) * step;
            if (reduced.matches) {
              play(el, [{ opacity: 0 }, { opacity: 1 }], { duration: 200, delay, easing: 'ease-out' });
              continue;
            }
            play(el, [{ opacity: 0 }, { opacity: 1 }], { duration: 280, delay: at, easing: OUT });
            play(el, [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], { duration: 520, delay: at, easing: SPRING });
          }
        };
        const leave = (els, { dx = 0, dy = 0 }) =>
          els.filter(seen).map((el, i) =>
            play(
              el,
              reduced.matches
                ? [{ opacity: 1 }, { opacity: 0 }]
                : [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translate(${dx}px, ${dy}px)` }],
              { duration: 110, delay: reduced.matches ? 0 : Math.min(i, 3) * 8, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' },
            ),
          );
        const after = (anims, fn) => {
          const mine = turn;
          Promise.all(anims.map((a) => a.finished)).then(
            () => mine === turn && fn(),
            () => {},
          );
        };
        const read = (url) => {
          const tab = url.pathname === '/notes/' ? 'notes' : 'projects';
          const tag = tab === 'notes' ? url.searchParams.get('tag') ?? '' : '';
          return { tab, tag: known.includes(tag) ? tag : '' };
        };
        const apply = (tag) => {
          const before = box.offsetHeight;
          for (const li of notes.querySelectorAll('.row')) {
            li.hidden = Boolean(tag) && !li.dataset.tags.split(' ').includes(tag);
          }
          if (box.offsetHeight < before) box.style.minHeight = `${before}px`;
        };
        const mark = (tag) => {
          for (const c of chips) {
            if (c.dataset.filter === tag) c.setAttribute('aria-current', 'page');
            else c.removeAttribute('aria-current');
          }
          notesTab.href = tag ? `/notes/?tag=${tag}` : '/notes/';
        };
        const current = () => (notes.inert ? 'projects' : 'notes');
        const filter = (tag) => {
          mark(tag);
          const now = notes.querySelectorAll('.row:not([hidden])').length;
          stop();
          const out = leave(rowsOf(notes), { dy: -6 });
          if (!out.length) {
            apply(tag);
            enter(rowsOf(notes), { dy: 10 });
            return;
          }
          after(out, () => {
            apply(tag);
            for (const a of out) a.cancel();
            enter(rowsOf(notes), { dy: 10, step: now ? 30 : 0 });
          });
        };
        const switchTo = (tab, tag) => {
          const from = panels.find((p) => p.dataset.panel === current());
          const to = panels.find((p) => p.dataset.panel === tab);
          const dir = tab === 'notes' ? 1 : -1;
          stop();
          if (tab === 'notes') {
            mark(tag);
            apply(tag);
          }
          from.inert = true;
          from.classList.add('leaving');
          const out = leave(rowsOf(from), { dx: -16 * dir });
          after(out, () => {
            from.classList.remove('leaving');
            for (const a of out) a.cancel();
          });
          to.inert = false;
          enter(rowsOf(to), { dx: 24 * dir, delay: 140 });
          if (!chipBar) return;
          if (tab === 'notes') {
            chipBar.inert = false;
            enter(chips, { dx: 14, delay: 100, step: 22 });
          } else {
            chipBar.inert = true;
            chipBar.classList.add('leaving');
            const gone = leave(chips, { dx: 10 });
            after(gone, () => {
              chipBar.classList.remove('leaving');
              for (const a of gone) a.cancel();
            });
          }
        };
        const show = ({ tab, tag }) => {
          document.documentElement.classList.add('instant');
          nav.style.setProperty('--at', tab === 'notes' ? '1' : '0');
          for (const a of tabs) {
            if (a.dataset.tab === tab) a.setAttribute('aria-current', 'page');
            else a.removeAttribute('aria-current');
          }
          if (heading) heading.textContent = tab === 'notes' ? 'Notes' : 'Projects';
          document.title = tabs.find((a) => a.dataset.tab === tab).dataset.title;
          if (tab !== current()) switchTo(tab, tag);
          else if (tab === 'notes' && tag !== chipBar?.querySelector('[aria-current="page"]')?.dataset.filter) filter(tag);
          try {
            localStorage.setItem('inspect:tab', tab === 'notes' ? '/notes/' : '/');
          } catch {}
        };
        const go = (href) => {
          const url = new URL(href, location.href);
          if (url.href === location.href) return;
          history.pushState({ ...history.state, y: undefined }, '', url);
          show(read(url));
        };
        const plain = (e) => !(e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey);
        nav.addEventListener('click', (e) => {
          const a = e.target.closest('a[data-tab]');
          if (!a || !plain(e)) return;
          e.preventDefault();
          go(a.href);
        });
        chipBar?.addEventListener('click', (e) => {
          const a = e.target.closest('a[data-filter]');
          if (!a || !plain(e)) return;
          e.preventDefault();
          go(a.href);
        });
        addEventListener('popstate', () => show(read(new URL(location.href))));
        const now = read(new URL(location.href));
        if (now.tag) {
          mark(now.tag);
          apply(now.tag);
        }
      })();
    </script>
  </>
)}
