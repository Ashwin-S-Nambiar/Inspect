---
import { allPosts, type Post, type Section, sectionOf, tagLabel } from '../lib/posts';
import { site } from '../site';
import Rows from './Rows.astro';

interface Props {
  posts: Post[];
  section?: Section;
  tag?: string;
}

const { posts, section, tag } = Astro.props;
const everything = await allPosts();
const notes = everything.filter((p) => sectionOf(p) === 'notes');
const count = { projects: everything.length - notes.length, notes: notes.length };
const filters = section === 'notes' || tag ? site.filters.filter((f) => notes.some((p) => p.data.tags.includes(f))) : [];
const heading = tag ? tagLabel(tag) : section === 'projects' ? 'Projects' : 'Notes';
---

{tag ? (
  <h2 class="sect" data-in style="--i:3">{heading} <span>{posts.length}</span></h2>
) : (
  <>
    <nav class="sections" aria-label="Sections" data-in style={`--i:3; --at:${section === 'notes' ? 1 : 0}`}>
      <span class="pill" aria-hidden="true"></span>
      {(['projects', 'notes'] as const).map((s) => (
        <a href={s === 'projects' ? '/' : '/notes/'} aria-current={s === section ? 'page' : undefined}>
          <span class="sec-l">{s === 'projects' ? 'Projects' : 'Notes'}</span>
          <span class="sec-n">{count[s]}</span>
        </a>
      ))}
    </nav>
    <h2 class="sr">{heading}</h2>
  </>
)}
{filters.length > 0 && (
  <nav class="filters" aria-label="Filter notes by tag" data-in style="--i:4">
    <a class="chip" href="/notes/" aria-current={tag ? undefined : 'page'}>All</a>
    {filters.map((f) => (
      <a class="chip" href={`/tags/${f}/`} aria-current={f === tag ? 'page' : undefined}>{tagLabel(f)}</a>
    ))}
    {tag && !filters.includes(tag) && <a class="chip" href={`/tags/${tag}/`} aria-current="page">{tagLabel(tag)}</a>}
  </nav>
)}
<Rows posts={posts} />
