---
interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<figure class="fig rp" data-rp>
  <div class="stage">
    <div class="stage-in">
      <div class="sheet">
        <canvas role="img" aria-label="A risograph print of a rock pool from above: the tide goes out, a crab comes out from under a rock to the pool's edge, and runs home as the sea comes back in."></canvas>
      </div>
      <div class="controls">
        <label>
          <span>Plates</span>
          <input type="range" min="1" max="4" step="1" value="4" data-k="plates" />
          <output>4</output>
        </label>
        <label>
          <span>Misregister</span>
          <input type="range" min="0" max="8" step="0.5" value="1.5" data-k="slip" />
          <output>1.5 px</output>
        </label>
        <label>
          <span>Dot pitch</span>
          <input type="range" min="2" max="9" step="0.5" value="3.5" data-k="pitch" />
          <output>3.5 px</output>
        </label>
        <label class="tog">
          <input type="checkbox" checked data-k="screened" />
          <span>Halftone</span>
        </label>
      </div>
      <ol class="controls inks" aria-label="Print order">
        <li><i style="background:#ffe800"></i>Yellow, 0°</li>
        <li><i style="background:#ff48b0"></i>Pink, 75°</li>
        <li><i style="background:#00a95c"></i>Green, 45°</li>
        <li><i style="background:#0078bf"></i>Blue, 15°</li>
      </ol>
    </div>
  </div>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<script>
  import { createPrinter, type Frame } from './riso/printer';
  import { LOOP } from './riso/tide';

  const FPS = 12;
  const STILL = 1.7;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  for (const fig of document.querySelectorAll<HTMLElement>('[data-rp]')) {
    const holder = fig.querySelector<HTMLElement>('.sheet');
    const canvas = holder?.querySelector('canvas');
    if (!holder || !canvas) continue;
    const input = (k: string) => fig.querySelector<HTMLInputElement>(`[data-k="${k}"]`);
    const items = [...fig.querySelectorAll('.inks li')];
    let send: ((f: Frame) => void) | null = null;
    let time = STILL;

    const request = () => {
      if (!send) return;
      const rect = holder.getBoundingClientRect();
      if (rect.width < 2 || rect.height < 2) return;
      const dpr = window.devicePixelRatio || 1;
      const width = Math.round(rect.width * dpr);
      const height = Math.round(rect.height * dpr);
      const plates = Number(input('plates')?.value ?? 4);
      items.forEach((li, i) => li.toggleAttribute('data-off', i >= plates));
      send({
        t: Math.floor(time * FPS) / FPS,
        width,
        height,
        dpr,
        pitch: Number(input('pitch')?.value ?? 3.5),
        slip: Number(input('slip')?.value ?? 1.5),
        plates,
        screened: input('screened')?.checked ?? true,
      });
    };

    const start = () => {
      if (send) return;
      if ('transferControlToOffscreen' in canvas && typeof OffscreenCanvas !== 'undefined') {
        const worker = new Worker(new URL('./riso/press.worker.ts', import.meta.url), { type: 'module' });
        const offscreen = canvas.transferControlToOffscreen();
        worker.postMessage({ canvas: offscreen }, [offscreen]);
        let busy = false;
        let waiting: Frame | null = null;
        worker.onmessage = () => {
          holder.toggleAttribute('data-inked', true);
          busy = false;
          if (waiting) {
            const next = waiting;
            waiting = null;
            busy = true;
            worker.postMessage(next);
          }
        };
        send = (f) => {
          if (busy) waiting = f;
          else {
            busy = true;
            worker.postMessage(f);
          }
        };
      } else {
        const print = createPrinter(canvas, (w, h) => {
          const layer = document.createElement('canvas');
          layer.width = w;
          layer.height = h;
          return layer.getContext('2d', { willReadFrequently: true }) as CanvasRenderingContext2D;
        });
        send = (f) => {
          print(f);
          holder.toggleAttribute('data-inked', true);
        };
      }
    };

    let raf = 0;
    let last = 0;
    let printed = -1;
    let onScreen = false;

    const tick = (now: number) => {
      if (last) time = (time + Math.min(0.1, (now - last) / 1000)) % LOOP;
      last = now;
      const frame = Math.floor(time * FPS);
      if (frame !== printed) {
        printed = frame;
        request();
      }
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    const sync = () => {
      if (onScreen && document.visibilityState === 'visible' && !reduced.matches) {
        if (raf) return;
        last = 0;
        raf = requestAnimationFrame(tick);
      } else {
        stop();
        if (reduced.matches) {
          time = STILL;
          request();
        }
      }
    };

    const units: Record<string, string> = { slip: ' px', pitch: ' px' };
    for (const el of fig.querySelectorAll<HTMLInputElement>('[data-k]')) {
      el.addEventListener('input', () => {
        const out = el.closest('label')?.querySelector('output');
        if (out) out.textContent = `${el.value}${units[el.dataset.k ?? ''] ?? ''}`;
        request();
      });
    }

    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        if (onScreen) {
          start();
          request();
        }
        sync();
      },
      { rootMargin: '200px' },
    ).observe(holder);
    new ResizeObserver(() => request()).observe(holder);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
  }
</script>

<style>
  .sheet {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #f2ede3;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 240ms ease;
  }

  [data-inked] canvas {
    opacity: 1;
  }

  .controls:not(.inks) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 6px 18px;
  }

  label {
    display: grid;
    grid-template-columns: 10ch minmax(0, 1fr) 6ch;
    align-items: center;
    gap: 8px;
  }

  label.tog {
    display: flex;
    cursor: pointer;
  }

  output {
    text-align: right;
  }

  .inks {
    margin: 0;
    list-style: none;
    gap: 6px 16px;
  }

  .inks li {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
    transition: opacity 160ms ease;
  }

  .inks li[data-off] {
    opacity: 0.35;
  }

  .inks i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
</style>
