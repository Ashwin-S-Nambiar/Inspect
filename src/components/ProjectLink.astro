---
import { Image } from 'astro:assets';

const project = Astro.locals.project;
const href = Astro.locals.writeUp ?? project?.live ?? project?.repo;
const name = project?.name.split(',')[0];
---

{project && href ? (
  <a class="plink" href={href} rel={Astro.locals.writeUp ? undefined : 'noopener'}>
    {project.icon && <Image src={project.icon} alt="" width={32} height={32} class="plink-ic" />}
    <slot>{name}</slot>
  </a>
) : (
  <slot>{name}</slot>
)}
