---
import { Image } from 'astro:assets';
import { href, type Post, shortDate, vt } from '../lib/posts';
import { site } from '../site';

interface Props {
  posts: Post[];
  start?: number;
}

const { posts, start = 5 } = Astro.props;
---

<ol class:list={['list', { thumbs: site.thumbs }]}>
  {posts.map((p, i) => {
    const thumb = p.data.thumb ?? p.data.hero?.image;
    return (
      <li class="row" data-in data-tags={p.data.tags.join(' ')} style={`--i:${Math.min(i, 8) + start}`}>
        <a class="row-link" href={href(p)} style={`view-transition-name: row-${vt(p)}; view-transition-class: row`}>
          {site.thumbs && (
            <span class="row-th" aria-hidden="true">
              {thumb ? (
                <Image src={thumb} alt="" width={224} height={140} fit="cover" loading="eager" decoding="async" />
              ) : (
                <span class="glyph">{p.data.glyph ?? p.data.title.slice(0, 1)}</span>
              )}
            </span>
          )}
          <span class="row-t" style={`view-transition-name: title-${vt(p)}; view-transition-class: hero-title`}>{p.data.title}</span>
          <span class="row-d">{p.data.dek}</span>
          <time class="row-m" datetime={p.data.date.toISOString()}>{shortDate(p.data.date)}</time>
        </a>
      </li>
    );
  })}
</ol>
