---
import { fontData } from 'astro:assets';

const families = [
  ['--font-sans', 'normal'],
  ['--font-mono', 'normal'],
  ['--font-serif', 'italic'],
] as const;
const urls = families
  .map(([v, style]) => fontData[v]?.find((f) => f.style === style)?.src[0]?.url)
  .filter((u): u is string => Boolean(u));
---

{urls.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
