---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

const TALL = 440;

interface Mark {
  x: number;
  y: number;
  w?: number;
  h?: number;
  note: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  marks: Mark[];
  caption?: string;
  mat?: string;
}

const { src, alt, marks, caption, mat } = Astro.props;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const ratio = src.width / src.height;
const wide = ratio > 1.2;
const tall = ratio < 1;
const fit = tall ? Math.round(TALL * ratio) : 0;
---

<figure
  class:list={['fig', 'annotated', { wide, tall, matted: Boolean(mat) }]}
  style={{ '--mat': mat, '--fit': fit ? `${fit}px` : undefined }}
  data-annotated data-marks={JSON.stringify(marks.map(({ x, y, w, h }) => [x, y, w ?? 0, h ?? 0]))}>
  <div class="stage">
    <div class="stage-in">
      <div class="pan">
        <div class="media inspect shot">
          <Picture
            src={src}
            alt={alt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[640, 960, 1280]}
            sizes={tall ? `${fit}px` : '(max-width: 660px) 760px, 620px'}
          />
          {marks.map((m, i) =>
            m.w && m.h ? (
              <span
                class:list={['box', { low: m.y < 9 }]}
                data-i={i}
                aria-hidden="true"
                style={{ '--x': m.x, '--y': m.y, '--w': m.w, '--h': m.h }}
              >
                <b>{pad(i)}</b>
              </span>
            ) : (
              <span class="pin" data-i={i} aria-hidden="true" style={{ '--x': m.x, '--y': m.y }}>{i + 1}</span>
            ),
          )}
        </div>
      </div>
      <span class="swipe" aria-hidden="true">swipe <span>&harr;</span></span>
    </div>
  </div>
  <ol class="notes">
    {marks.map((m, i) => (
      <li>
        <button type="button" class="note" data-i={i} aria-pressed="false">
          <span class="note-n">{pad(i)}</span>
          <span>{m.note}</span>
        </button>
      </li>
    ))}
  </ol>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<script>
  type Mark = [number, number, number, number];
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  for (const fig of document.querySelectorAll<HTMLElement>('[data-annotated]')) {
    const shot = fig.querySelector<HTMLElement>('.shot');
    const pan = fig.querySelector<HTMLElement>('.pan');
    if (!shot || !pan) continue;
    const marks = JSON.parse(fig.dataset.marks ?? '[]') as Mark[];
    const parts = [...shot.querySelectorAll<HTMLElement>('[data-i]')];
    const notes = [...fig.querySelectorAll<HTMLButtonElement>('.note')];
    let pinned = -1;
    let lit = -2;

    const light = (i: number) => {
      if (i === lit) return;
      lit = i;
      parts.forEach((p, j) => p.classList.toggle('on', j === i));
      notes.forEach((n, j) => {
        n.classList.toggle('on', j === i);
        n.setAttribute('aria-pressed', String(j === pinned));
      });
    };

    const hit = (e: PointerEvent | MouseEvent) => {
      const r = shot.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * 100;
      const py = ((e.clientY - r.top) / r.height) * 100;
      let best = -1;
      let area = Number.POSITIVE_INFINITY;
      marks.forEach(([x, y, w, h], i) => {
        const inside = w
          ? px >= x && px <= x + w && py >= y && py <= y + h
          : Math.hypot(((px - x) / 100) * r.width, ((py - y) / 100) * r.height) < 26;
        const size = w ? w * h : 0;
        if (inside && size < area) {
          best = i;
          area = size;
        }
      });
      return best;
    };

    let moved = false;
    const edges = () => {
      const max = shot.offsetWidth - pan.clientWidth;
      const at = pan.scrollLeft;
      if (at > 4) moved = true;
      pan.dataset.edge = max <= 1 ? '' : at <= 1 ? 'end' : at >= max - 1 ? 'start' : 'both';
      fig.toggleAttribute('data-hint', max > 1 && !moved);
    };
    pan.addEventListener('scroll', edges, { passive: true });
    addEventListener('resize', edges);
    edges();

    const reveal = (i: number) => {
      if (i < 0 || shot.offsetWidth <= pan.clientWidth) return;
      const [x, , w] = marks[i];
      const left = ((x + w / 2) / 100) * shot.clientWidth - pan.clientWidth / 2;
      pan.scrollTo({ left, behavior: reduced.matches ? 'auto' : 'smooth' });
    };

    shot.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !fine.matches) return;
      const i = hit(e);
      light(i >= 0 ? i : pinned);
    });
    shot.addEventListener('pointerleave', () => light(pinned));
    shot.addEventListener('click', (e) => {
      const i = hit(e);
      pinned = i === pinned ? -1 : i;
      lit = -2;
      light(pinned);
    });

    notes.forEach((n, i) => {
      n.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && fine.matches) light(i);
      });
      n.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') light(pinned);
      });
      n.addEventListener('focus', () => {
        if (n.matches(':focus-visible')) light(i);
      });
      n.addEventListener('blur', () => light(pinned));
      n.addEventListener('click', () => {
        pinned = i === pinned ? -1 : i;
        lit = -2;
        light(pinned >= 0 ? pinned : fine.matches ? i : -1);
        reveal(pinned);
      });
    });
  }
</script>

<style>
  .pan {
    overflow: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .tall .stage-in {
    display: grid;
    justify-items: center;
    padding: clamp(16px, 5vw, 28px);
    background: var(--stage);
  }

  .tall .pan {
    width: min(100%, var(--fit));
  }

  .tall .shot :global(img) {
    border-radius: 8px;
    box-shadow:
      0 0 0 1px var(--card-line),
      0 6px 20px rgb(20 20 19 / 0.08);
  }

  .matted .stage-in {
    background: var(--mat);
  }

  .matted .shot :global(img) {
    border-radius: 0;
    box-shadow: none;
  }

  .pan::-webkit-scrollbar {
    display: none;
  }

  .pan[data-edge='end'] {
    mask-image: linear-gradient(90deg, #000 calc(100% - 40px), rgb(0 0 0 / 0.35));
  }

  .pan[data-edge='start'] {
    mask-image: linear-gradient(270deg, #000 calc(100% - 40px), rgb(0 0 0 / 0.35));
  }

  .pan[data-edge='both'] {
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.35), #000 40px, #000 calc(100% - 40px), rgb(0 0 0 / 0.35));
  }

  .swipe {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--card-line), 0 2px 8px rgb(20 20 19 / 0.08);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 16px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  [data-hint] .swipe {
    opacity: 1;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .wide .pan {
      overflow-x: auto;
    }

    .wide .shot {
      width: 760px;
    }
  }
</style>
